# Copy to .env and fill in. .env is gitignored.
# Serper API key for board discovery (https://serper.dev). Without it, discovery is skipped.
SEARCH_API_KEY=

# Phase 3 — scoring and daily digest
# Anthropic API key for Haiku scoring.
ANTHROPIC_API_KEY=
# Postgres connection string (Neon). Unset = local SQLite (jobhunt.db).
DATABASE_URL=
# Resume text. Locally these fall back to private/resumes/se.md and fde.md (gitignored).
RESUME_SE=
RESUME_FDE=
# Gmail SMTP with an app password (needs 2FA on the account).
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
DIGEST_TO=

# Phase 5 — remote MCP server (brief M). The server is its own OAuth authorization server and
# logs in with a GitHub OAuth app (callback: <JOBHUNT_PUBLIC_URL>/oauth/github/callback).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# The one GitHub account allowed in, by numeric id (gh api user --jq .id), not login.
JOBHUNT_ALLOWED_GITHUB_ID=
# Public base URL of the hosted server, scheme and host only, e.g. https://jobhunt-abc.a.run.app
JOBHUNT_PUBLIC_URL=
